# Pengembangan lokal: web memakai fungsi rewrite Next dev sebagai proxy /api
# ke API NestJS di port 3001 (same-origin, bebas masalah CORS & cookie).
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_SHOW_DEMO_HINTS="true"

# Opsional (dev): origin yang boleh memakai resource dev Next.js, dipisah koma.
# Isi IP LAN atau hostname tunnel bila menguji dari perangkat lain.
ALLOWED_DEV_ORIGINS=""

# Production Cloudflare Pages: gunakan path relatif agar request /api
# diproxy oleh functions/api/[[path]].ts pada origin yang sama.
# NEXT_PUBLIC_API_URL="/api"
# NEXT_PUBLIC_SHOW_DEMO_HINTS="false"
