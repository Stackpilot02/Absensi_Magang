# ===== Database =====
# Rekomendasi: Neon (serverless PostgreSQL) — https://neon.tech
#
# Di Neon Console > Connect, salin DUA connection string:
#   1. "Pooled connection"   -> host mengandung "-pooler"  -> DATABASE_URL
#   2. "Direct connection"   -> host tanpa "-pooler"       -> DIRECT_URL (migrasi/seed)
#
# Untuk pengembangan lokal, WAJIB memakai Neon branch terpisah (mis. `dev`) agar
# seed/migrate lokal tidak menyentuh data produksi. Buat branch dari branch default
# (di Neon bisa bernama `production` atau `main`), set auto-delete ke "Never", lalu
# salin connection string dari branch tersebut.
#
# Catatan parameter:
#   - sslmode=require       : Neon wajib SSL.
#   - pgbouncer=true        : mematikan prepared statement (Neon memakai PgBouncer
#                             transaction mode). Aman dipakai, tidak merusak data.
#   - connection_limit=3    : batasi koneksi per instance backend agar tidak
#                             menghabiskan kuota koneksi Neon.
#   - connect_timeout=15    : beri waktu saat compute Neon bangun dari suspend.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=3"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Alternatif: PostgreSQL lokal via docker compose up -d ---
# Komentar baris Neon di atas, lalu aktifkan dua baris berikut:
# DATABASE_URL="postgresql://absensi:absensi_local_dev@localhost:5433/absensi_magang?schema=public"
# DIRECT_URL="postgresql://absensi:absensi_local_dev@localhost:5433/absensi_magang?schema=public"

# ===== Autentikasi =====
# WAJIB diganti dengan nilai acak kuat (minimal 32 karakter) di setiap environment.
JWT_SECRET="ganti-dengan-random-string-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# ===== Aplikasi =====
# Di VPS production, bind ke loopback agar hanya cloudflared yang bisa mengakses API.
HOST="0.0.0.0"
PORT="3001"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
TZ="Asia/Jakarta"

# ===== Cloudflare Pages Function proxy =====
# Samakan dengan PROXY_SHARED_SECRET pada environment Cloudflare Pages.
# Kosongkan untuk lokal; wajib di production agar audit log dan rate limit
# memakai IP asli pengguna, bukan IP proxy Cloudflare.
PROXY_SHARED_SECRET=""

# ===== Aturan absensi =====
# Jam masuk kantor (format HH:mm, zona Asia/Jakarta)
WORK_START_TIME="07:30"
# Jam pulang kantor; absen pulang baru dibuka mulai jam ini
WORK_END_TIME="16:00"
# Toleransi keterlambatan dalam menit (0 = tidak ada toleransi)
LATE_TOLERANCE_MINUTES="0"
# Batas selisih waktu perangkat vs server (detik) untuk anti manipulasi jam
MAX_CLOCK_SKEW_SECONDS="300"

# ===== Contoh nilai production (VPS + Cloudflare Pages) =====
# Jangan aktifkan baris ini di .env lokal. Gunakan file terpisah di
# /etc/absensi/api.env; lihat deploy/vps/api.env.example.
# NODE_ENV="production"
# HOST="127.0.0.1"
# COOKIE_SECURE="true"
# COOKIE_SAME_SITE="lax"
# CORS_ORIGIN="https://absensi.pages.dev"
# PROXY_SHARED_SECRET="ganti-dengan-openssl-rand-hex-32"
