# ===== Database =====
# Rekomendasi: Neon (serverless PostgreSQL) — https://neon.tech
#
# Di Neon Console > Connect, salin DUA connection string:
#   1. "Pooled connection"   -> host mengandung "-pooler"  -> DATABASE_URL
#   2. "Direct connection"   -> host tanpa "-pooler"       -> DIRECT_URL (migrasi/seed)
#
# Catatan parameter:
#   - sslmode=require       : Neon wajib SSL.
#   - pgbouncer=true        : mematikan prepared statement (Neon memakai PgBouncer
#                             transaction mode). Aman dipakai, tidak merusak data.
#   - connection_limit=5    : batasi koneksi per instance backend agar tidak
#                             menghabiskan kuota koneksi Neon.
#   - connect_timeout=15    : beri waktu saat compute Neon bangun dari suspend.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Alternatif: PostgreSQL lokal via docker compose up -d ---
# Komentar baris Neon di atas, lalu aktifkan dua baris berikut:
# DATABASE_URL="postgresql://absensi:absensi_local_dev@localhost:5433/absensi_magang?schema=public"
# DIRECT_URL="postgresql://absensi:absensi_local_dev@localhost:5433/absensi_magang?schema=public"

# ===== Autentikasi =====
# WAJIB diganti dengan nilai acak kuat (minimal 32 karakter) di setiap environment.
JWT_SECRET="ganti-dengan-random-string-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# ===== Aplikasi =====
PORT="3001"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
TZ="Asia/Jakarta"

# ===== Aturan absensi =====
# Jam masuk kantor (format HH:mm, zona Asia/Jakarta)
WORK_START_TIME="08:00"
# Toleransi keterlambatan dalam menit
LATE_TOLERANCE_MINUTES="15"
# Batas selisih waktu perangkat vs server (detik) untuk anti manipulasi jam
MAX_CLOCK_SKEW_SECONDS="300"
