# Direct connection Neon (tanpa -pooler). Jangan memakai DATABASE_URL pooled
# karena pg_dump membutuhkan koneksi langsung.
NEON_DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Remote rclone untuk Cloudflare R2, contoh: r2:absensi-backup
R2_REMOTE="r2:absensi-backup"

BACKUP_DIR="/var/backups/absensi"
RETENTION_DAYS="14"
REMOTE_RETENTION_DAYS="30"
TZ="Asia/Jakarta"
