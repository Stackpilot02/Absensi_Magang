# ===== Runtime =====
NODE_ENV="production"
# Bind ke loopback; hanya cloudflared di VPS yang boleh mengakses API.
HOST="127.0.0.1"
PORT="3001"
TZ="Asia/Jakarta"

# ===== Database Neon =====
# Pooled connection (host mengandung -pooler) untuk runtime API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=3"
# Direct connection (tanpa -pooler) untuk migrasi, seed, dan pg_dump.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ===== Autentikasi =====
# Buat dengan: openssl rand -base64 48
JWT_SECRET="GANTI_DENGAN_RANDOM_MINIMAL_32_KARAKTER"
JWT_EXPIRES_IN="8h"
# Browser selalu mengakses Cloudflare Pages via HTTPS, jadi cookie wajib Secure.
COOKIE_SECURE="true"
COOKIE_SAME_SITE="lax"

# ===== Frontend =====
# Origin Cloudflare Pages, tanpa trailing slash. Boleh beberapa origin
# dipisahkan koma (mis. domain pages.dev dan custom domain).
CORS_ORIGIN="https://absensi-magang.pages.dev"

# ===== Cloudflare Pages Function proxy =====
# Buat dengan: openssl rand -hex 32
# Samakan nilainya dengan PROXY_SHARED_SECRET di environment Pages.
PROXY_SHARED_SECRET="GANTI_DENGAN_RANDOM_MINIMAL_16_KARAKTER"

# ===== Aturan absensi =====
WORK_START_TIME="07:30"
WORK_END_TIME="16:00"
LATE_TOLERANCE_MINUTES="0"
MAX_CLOCK_SKEW_SECONDS="300"
